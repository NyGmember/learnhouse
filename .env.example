# ==============================================================================
# LearnHouse Environment Variables Configuration
# Production Multi-Container Microservices Architecture
# Optimized for Portainer / Synology DSM / TrueNAS SCALE Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storage & Persistence Configuration
# ------------------------------------------------------------------------------
# Base directory path on your host (e.g. Synology NAS: /volume1/docker/learnhouse)
# Subfolders created automatically under this path:
#   - postgres_data: Database files
#   - redis_data: Redis persistence (AOF/RDB)
#   - storage: Uploaded course media, documents, and assets
DATA_DIR=/volume1/docker/learnhouse

# ------------------------------------------------------------------------------
# 2. Host Port Mapping Configuration
# ------------------------------------------------------------------------------
# Web Frontend Port (Host -> Container 3000)
WEB_PORT=8280

# API Backend Port (Host -> Container 8000)
API_PORT=8290

# WebSocket Collaboration Server Port (Host -> Container 1234)
COLLAB_PORT=8240

# ------------------------------------------------------------------------------
# 3. Database Credentials (PostgreSQL / pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=learnhouse_secure_password_change_me
POSTGRES_DB=learnhouse

# Optional: Override full connection string if using an external database
# LEARNHOUSE_SQL_CONNECTION_STRING=postgresql+asyncpg://learnhouse:password@postgres:5432/learnhouse

# ------------------------------------------------------------------------------
# 4. Security & Cryptography Secrets
# ------------------------------------------------------------------------------
# REQUIRED: JWT Secret Key for API authentication (min 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_a_very_secure_random_string_at_least_32_characters_long

# REQUIRED: Internal Shared Key between Backend API and Collab WebSocket server
COLLAB_INTERNAL_KEY=generate_an_internal_service_secret_key_here

# ------------------------------------------------------------------------------
# 5. External & Public URLs (Used by Browser Clients)
# ------------------------------------------------------------------------------
# Public URL where users access the Web frontend in their browser
FRONTEND_URL=http://localhost:8280

# Public URL for the API backend (used by frontend browser requests)
PUBLIC_API_URL=http://localhost:8290

# Public WebSocket URL for the Collab server (e.g., ws:// or wss://)
PUBLIC_COLLAB_WS_URL=ws://localhost:8240

# Domain & Tenancy Configuration
DOMAIN=localhost
FRONTEND_DOMAIN=localhost:8280
SSL=false
DEVELOPMENT_MODE=false

# ------------------------------------------------------------------------------
# 6. AI Integration & LLM Configuration (Multi-Provider Support)
# ------------------------------------------------------------------------------
# Enable or disable AI features across the platform
IS_AI_ENABLED=true

# ==============================================================================
# OPTION A: OpenRouter Configuration (Recommended for Multiple Models)
# ==============================================================================
# OpenRouter provides unified access to Claude, GPT-4o, DeepSeek, Llama 3, Gemini, etc.
# Get your API Key from: https://openrouter.ai/keys
#
# To use OpenRouter:
# 1. Set LEARNHOUSE_AI_PROVIDER=openrouter
# 2. Set LEARNHOUSE_AI_API_KEY to your OpenRouter key
# 3. Specify OpenRouter model slugs for each tier
#
# LEARNHOUSE_AI_PROVIDER=openrouter
# LEARNHOUSE_AI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# OpenRouter Model Slugs Examples:
#   Fast tier (Quick suggestions, course titles, follow-up questions):
#   - openai/gpt-4o-mini
#   - google/gemini-2.5-flash
#   - deepseek/deepseek-chat
#   - anthropic/claude-3.5-haiku
#   - meta-llama/llama-3.3-70b-instruct
# LEARNHOUSE_AI_MODEL_FAST=openai/gpt-4o-mini
#
#   Standard tier (Course assistance, Q&A, chat):
#   - openai/gpt-4o
#   - anthropic/claude-3.7-sonnet
#   - deepseek/deepseek-chat
#   - google/gemini-2.5-flash
# LEARNHOUSE_AI_MODEL_STANDARD=openai/gpt-4o-mini
#
#   Pro tier (Complex course planning, curriculum generation):
#   - openai/gpt-4o
#   - anthropic/claude-3.7-sonnet
#   - deepseek/deepseek-r1
# LEARNHOUSE_AI_MODEL_PRO=openai/gpt-4o
#
# NOTE FOR OPENROUTER USERS:
# OpenRouter is a text-generation gateway and does not provide an embeddings API.
# LearnHouse will automatically use Google Gemini Embeddings (free) for RAG Search
# if GEMINI_API_KEY is provided below. You can also configure OpenAI embeddings.
# ==============================================================================

# ==============================================================================
# OPTION B: Google Gemini Configuration (Direct / Free Tier Supported)
# ==============================================================================
# Get your Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Provider selection (google | openrouter | openai | anthropic | deepseek | ollama)
LEARNHOUSE_AI_PROVIDER=google
LEARNHOUSE_AI_API_KEY=your_gemini_api_key_here

# Model Tiers for Gemini (gemini-2.5-flash or gemini-2.0-flash is recommended for Free Tier):
LEARNHOUSE_AI_MODEL_FAST=gemini-2.5-flash
LEARNHOUSE_AI_MODEL_STANDARD=gemini-2.5-flash
LEARNHOUSE_AI_MODEL_PRO=gemini-2.5-flash

# Image and Audio/TTS Models (Powered by Google GenAI SDK):
LEARNHOUSE_AI_IMAGE_MODEL=gemini-2.5-flash-image
LEARNHOUSE_AI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ==============================================================================
# OPTION C: Custom OpenAI / Ollama / Local Embeddings (Optional Override)
# ==============================================================================
# LEARNHOUSE_AI_BASE_URL=http://your-ollama-host:11434/v1
# LEARNHOUSE_AI_EMBEDDING_PROVIDER=openai
# LEARNHOUSE_AI_EMBEDDING_MODEL=text-embedding-3-small
# LEARNHOUSE_AI_EMBEDDING_DIMENSIONS=768

# ------------------------------------------------------------------------------
# 7. Content Delivery & Media Storage
# ------------------------------------------------------------------------------
# Content delivery type: "filesystem" (local storage) or "s3api" (S3 / MinIO / Cloudflare R2)
CONTENT_DELIVERY_TYPE=filesystem

# Optional S3 configuration (if CONTENT_DELIVERY_TYPE=s3api)
# LEARNHOUSE_S3_API_BUCKET_NAME=my-bucket
# LEARNHOUSE_S3_API_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 8. Email / SMTP Configuration (Optional)
# ------------------------------------------------------------------------------
# Email provider: "smtp" or "resend"
EMAIL_PROVIDER=smtp
SYSTEM_EMAIL_ADDRESS=noreply@example.com

# SMTP Settings (e.g. Gmail / Outlook / Mailgun / AWS SES)
# For Gmail: Use port 587 and an App Password from Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# Resend API Key (if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_xxxxxxxx

# ------------------------------------------------------------------------------
# 9. Initial Superadmin & Site Branding Settings
# ------------------------------------------------------------------------------
SITE_NAME=LearnHouse
SITE_DESCRIPTION=Open Source Learning Management System
CONTACT_EMAIL=admin@example.com

# Initial Superadmin Credentials (used during the very first database initialization)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeThisAdminPassword123!
